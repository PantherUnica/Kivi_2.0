# ---------------------------------------------------------------------------
# Kivi - semantic memory. Copy to `.env` before `docker compose up`.
# Every variable the system reads is listed here. Nothing else is required.
# ---------------------------------------------------------------------------

# --- Database (defaults match docker-compose.yml; change only if you must) ---
POSTGRES_USER=kivi
POSTGRES_PASSWORD=kivi
POSTGRES_DB=kivi
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kivi:kivi@db:5432/kivi

# --- LLM provider -----------------------------------------------------------
# One of: mock | sarvam | openai_compatible
#   mock              zero credentials, deterministic, runs the whole pipeline
#   sarvam            hosted open-weight sarvam-m  (set SARVAM_API_KEY)
#   openai_compatible local Qwen3-8B via vLLM / Ollama / LM Studio
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-m

# Required when LLM_PROVIDER=openai_compatible
# e.g. http://host.docker.internal:11434/v1  (Ollama)
#      http://host.docker.internal:8000/v1   (vLLM)
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=qwen3:8b

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=6

# --- Embedding provider -----------------------------------------------------
# One of: fastembed | qwen3 | hashing
#   fastembed  BAAI/bge-small-en-v1.5   384 dims   ~130MB, CPU  (default)
#   qwen3      Qwen/Qwen3-Embedding-0.6B 1024 dims ~1.2GB, CPU
#   hashing    pure-numpy deterministic  384 dims   0 download, offline
# Changing this changes EMBED_DIM, which is baked into the pgvector columns.
# After changing it you MUST run `make reset`.
EMBEDDING_PROVIDER=fastembed
EMBED_DIM=384
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- ASR provider -----------------------------------------------------------
# One of: replay | indicconformer | whisper
# `replay` reads transcripts from the corpus. No speech recognition is built.
ASR_PROVIDER=replay

# --- Memory policy thresholds (see DECISIONS.md D-13, D-14) -----------------
POLICY_DUPLICATE_COSINE=0.88
POLICY_CONTRADICTION_COSINE=0.55
POLICY_PROMOTE_AFTER_CORROBORATIONS=2

# --- RAG / retrieval (see DECISIONS.md D-16, D-17) --------------------------
RAG_TOP_K_MEMORIES=8
RAG_TOP_K_CHUNKS=10
RAG_TOP_K_EPISODES=6
RAG_RRF_K=60
RAG_SUPPORT_THRESHOLD=0.28
RAG_MIN_SIMILARITY=0.42
RAG_W_SIMILARITY=0.50
RAG_W_CONFIDENCE=0.25
RAG_W_RECENCY=0.15
RAG_W_SCOPE=0.20
RAG_P_INACTIVE=0.30
RAG_P_SUPERSEDED_SOURCE=0.35

# --- Pricing, for the cost meter (USD per 1M tokens) ------------------------
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.30

# --- App --------------------------------------------------------------------
KIVI_USER_HANDLE=maya
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE=http://localhost:8000
LOG_LEVEL=INFO
